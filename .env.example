# Nexora Quant — stable single-symbol L2 desk (default)
# Ana motor = tek proses: uvicorn app.api:app  (capture_multi_symbol.py GEREKMEZ)
SYMBOL=btcusdt
SYMBOLS=
TRADING_MODE=paper
BINANCE_TESTNET=true

STARTING_CASH_USDT=30
ORDER_SIZE_USDT=8
MAX_ORDER_SIZE_USDT=12
MIN_ORDER_USDT=5

# Tek sembol L2 (şişme yok). Çoklu tarama için: UNIVERSE_AUTO=true DEPTH_TOP_N=3
UNIVERSE_AUTO=false
DEPTH_TOP_N=1
AUTONOMOUS_MODE=true
AUTONOMOUS_SYMBOL=false

ENTRY_MIN_SCORE=0.32
SIGNAL_CONFIRMATIONS=1
IMBALANCE_THRESHOLD=0.60

TAKE_PROFIT_PCT=1.20
STOP_LOSS_PCT=0.35
TRAILING_STOP_PCT=0.25
MIN_REWARD_RISK_RATIO=2.0
COMPOUND_FRACTION=0.85

MAX_DAILY_LOSS_USDT=5
MAX_CONSECUTIVE_LOSSES=5
FEE_RATE=0.001

# Disk yükü kapalı — L2 bellek içi, dashboard aynı proses
MARKET_HISTORY_ENABLED=false
LOG_LEVEL=INFO
