# Nexora Quant — 100 USDT paper scalp desk (fee-aware, multi-coin, anti-churn)
SYMBOL=btcusdt
SYMBOLS=ethusdt,solusdt,bnbusdt,xrpusdt,adausdt,dogeusdt,avaxusdt,linkusdt
TRADING_MODE=paper
BINANCE_TESTNET=true

STARTING_CASH_USDT=100
ORDER_SIZE_USDT=12
MAX_ORDER_SIZE_USDT=20
MIN_ORDER_USDT=6

# Multi-coin: Binance majors screened → top DEPTH_TOP_N L2 streams; router picks best when flat
UNIVERSE_AUTO=true
DEPTH_TOP_N=5
AUTONOMOUS_MODE=true
AUTONOMOUS_SYMBOL=true

USE_ATR_TARGETS=true
VOL_TARGET_ENABLED=true
RISK_PER_TRADE_PCT=0.35
MAX_CONCURRENT_POSITIONS=1
WICK_STOP_CONFIRMATIONS=2

# Entry (was 0.28 — too selective for paper learning)
ENTRY_MIN_SCORE=0.20
SIGNAL_CONFIRMATIONS=1
IMBALANCE_THRESHOLD=0.55

# Fee-aware band (~0.55% TP / ~0.18% SL; ATR can widen)
TAKE_PROFIT_PCT=0.55
STOP_LOSS_PCT=0.18
TRAILING_STOP_PCT=0.12
MIN_REWARD_RISK_RATIO=2.0
COMPOUND_FRACTION=0.80
MIN_EDGE_OVER_FEES=1.2

# Anti-churn (still on — but MIN_HOLD was 180s and blocked TP)
MIN_HOLD_SECONDS=90
MAX_TRADES_PER_HOUR=12
MAX_DAILY_FEE_USDT=4.0
ENTRY_COOLDOWN_SECONDS=30
MAX_HOLD_SECONDS=2700

MAX_DAILY_LOSS_USDT=8
MAX_CONSECUTIVE_LOSSES=4
MAX_SPREAD_BPS=25

FEE_RATE=0.001
FEE_USE_BNB_DISCOUNT=true
MARKET_HISTORY_ENABLED=false
LEARNER_FROZEN=false
PAPER_SOFT_GATES=true
LEARNER_MIN_TRADES=12

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
