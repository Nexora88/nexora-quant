# Nexora Quant — 100 USDT paper desk (multi-coin screen + ATR vol targeting)
SYMBOL=btcusdt
SYMBOLS=ethusdt,solusdt,bnbusdt,xrpusdt
TRADING_MODE=paper
BINANCE_TESTNET=true

STARTING_CASH_USDT=100
ORDER_SIZE_USDT=15
MAX_ORDER_SIZE_USDT=25
MIN_ORDER_USDT=6

# Multi-coin analysis → router picks best when flat (still 1 open position)
UNIVERSE_AUTO=true
DEPTH_TOP_N=5
AUTONOMOUS_MODE=true
AUTONOMOUS_SYMBOL=true

# Dynamic risk
USE_ATR_TARGETS=true
VOL_TARGET_ENABLED=true
RISK_PER_TRADE_PCT=0.40
MAX_CONCURRENT_POSITIONS=1

ENTRY_MIN_SCORE=0.26
SIGNAL_CONFIRMATIONS=1
IMBALANCE_THRESHOLD=0.58

# Baseline (overridden live by ATR when USE_ATR_TARGETS=true)
TAKE_PROFIT_PCT=1.20
STOP_LOSS_PCT=0.35
TRAILING_STOP_PCT=0.25
MIN_REWARD_RISK_RATIO=2.0
COMPOUND_FRACTION=0.85

MAX_DAILY_LOSS_USDT=12
MAX_CONSECUTIVE_LOSSES=5
MAX_SPREAD_BPS=25

FEE_RATE=0.001
MARKET_HISTORY_ENABLED=false
LOG_LEVEL=INFO
