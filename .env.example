SYMBOL=btcusdt
# Optional extra pairs for paper multi-stream capture (research):
# SYMBOLS=ethusdt,solusdt,bnbusdt
TRADING_MODE=paper
AUTONOMOUS_MODE=true
COMPOUND_FRACTION=0.85
MIN_ORDER_USDT=5
ORDER_SIZE_USDT=10
MAX_ORDER_SIZE_USDT=25
# Asymmetric R:R (TP/SL >= MIN_REWARD_RISK_RATIO). Default ~3.4:1
TAKE_PROFIT_PCT=1.20
STOP_LOSS_PCT=0.35
MIN_REWARD_RISK_RATIO=2.0
ENTRY_MIN_SCORE=0.32
SIGNAL_CONFIRMATIONS=1
TRAILING_STOP_PCT=0.25
MAX_DAILY_LOSS_USDT=5
# Fees: base override, or VIP + BNB discount (see app/fees.py)
FEE_RATE=0.001
FEE_VIP_LEVEL=0
FEE_USE_BNB_DISCOUNT=false
# Paper stop path: aggressive stress on SL/trailing sells (thin books)
STOP_STRESS_MULTIPLIER=2.5
STOP_TAIL_BPS=8
SIMULATED_SLIPPAGE_BPS=2
IMPACT_COEFFICIENT=0.1
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
