# Nexora Quant — 100 USDT paper scalp desk (fee-aware, multi-coin, anti-churn)
SYMBOL=btcusdt
SYMBOLS=ethusdt,solusdt,bnbusdt,xrpusdt,adausdt,dogeusdt,avaxusdt,linkusdt
TRADING_MODE=paper
BINANCE_TESTNET=true

STARTING_CASH_USDT=100
# Soft session goal (halt new entries when equity hits target)
TARGET_EQUITY_USDT=140
ORDER_SIZE_USDT=12
MAX_ORDER_SIZE_USDT=20
MIN_ORDER_USDT=6

UNIVERSE_AUTO=true
DEPTH_TOP_N=5
AUTONOMOUS_MODE=true
AUTONOMOUS_SYMBOL=true

USE_ATR_TARGETS=true
VOL_TARGET_ENABLED=true
RISK_PER_TRADE_PCT=0.35
MAX_CONCURRENT_POSITIONS=1
WICK_STOP_CONFIRMATIONS=2

ENTRY_MIN_SCORE=0.22
SIGNAL_CONFIRMATIONS=1
IMBALANCE_THRESHOLD=0.55

# Slightly wider TP for fee survival when maker path is used
TAKE_PROFIT_PCT=0.65
STOP_LOSS_PCT=0.22
TRAILING_STOP_PCT=0.14
MIN_REWARD_RISK_RATIO=2.0
COMPOUND_FRACTION=0.80
MIN_EDGE_OVER_FEES=1.25

MIN_HOLD_SECONDS=120
MAX_TRADES_PER_HOUR=8
MAX_DAILY_FEE_USDT=3.0
ENTRY_COOLDOWN_SECONDS=45
MAX_HOLD_SECONDS=2700

MAX_DAILY_LOSS_USDT=8
MAX_CONSECUTIVE_LOSSES=4
MAX_SPREAD_BPS=22

FEE_RATE=0.001
# Enable only when your account actually pays eligible fees in BNB and has sufficient BNB.
FEE_USE_BNB_DISCOUNT=false
FEE_VIP_LEVEL=0
PREFER_MAKER=true
MAKER_WAIT_SECONDS=8
MARKET_HISTORY_ENABLED=false
LEARNER_FROZEN=false
PAPER_SOFT_GATES=true
# Resume saved paper account/position on restart; do not silently reset ledger.
PAPER_RESUME_POSITION=true
LEARNER_MIN_TRADES=25
# Halt entries if fee-net expectancy < 0 after this many closed sells
EXPECTANCY_MIN_TRADES=12

# Remote dashboard: set a long random token for LAN/VPS access.
NEXORA_API_TOKEN=
# Set true only on a trusted home/office LAN if you intentionally want no token.
NEXORA_ALLOW_LAN=false

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
