# Nexora Quant — 100 USDT paper desk (balanced, fee-aware)
SYMBOL=btcusdt
SYMBOLS=
TRADING_MODE=paper
BINANCE_TESTNET=true

# Bankroll (env is source of truth; paper SQLite rebases if no open position)
STARTING_CASH_USDT=100
ORDER_SIZE_USDT=15
MAX_ORDER_SIZE_USDT=25
MIN_ORDER_USDT=6

UNIVERSE_AUTO=false
DEPTH_TOP_N=1
AUTONOMOUS_MODE=true
AUTONOMOUS_SYMBOL=false

ENTRY_MIN_SCORE=0.28
SIGNAL_CONFIRMATIONS=1
IMBALANCE_THRESHOLD=0.58

TAKE_PROFIT_PCT=1.20
STOP_LOSS_PCT=0.35
TRAILING_STOP_PCT=0.25
MIN_REWARD_RISK_RATIO=2.0
COMPOUND_FRACTION=0.85

MAX_DAILY_LOSS_USDT=12
MAX_CONSECUTIVE_LOSSES=5
MAX_SPREAD_BPS=25

FEE_RATE=0.001
FEE_VIP_LEVEL=0
FEE_USE_BNB_DISCOUNT=false

MARKET_HISTORY_ENABLED=false
LOG_LEVEL=INFO
