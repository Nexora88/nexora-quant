SYMBOL=btcusdt
# paper | live
TRADING_MODE=paper
STARTING_CASH_USDT=1000
ORDER_SIZE_USDT=25
FEE_RATE=0.001
MAX_ORDER_SIZE_USDT=50
MAX_DAILY_LOSS_USDT=25
MAX_CONSECUTIVE_LOSSES=3
MAX_SPREAD_BPS=20
MAX_DATA_AGE_SECONDS=5
IMBALANCE_THRESHOLD=0.70
SIGNAL_CONFIRMATIONS=3
ENTRY_MIN_SCORE=0.55
TAKE_PROFIT_PCT=1.0
STOP_LOSS_PCT=0.5
# Peak'ten geri çekilmede çıkış (0 = kapalı)
TRAILING_STOP_PCT=0.35
# Mutlak hedef fiyat (USDT). Boş = kapalı. Örn: 72000
# TARGET_PRICE=

SIMULATED_SLIPPAGE_BPS=2
SIMULATED_LATENCY_MS=100
SIMULATED_PARTIAL_FILL_PROBABILITY=0.15
SIMULATION_SEED=0
PAPER_DB_PATH=data/paper.sqlite3
LOG_LEVEL=INFO
MARKET_HISTORY_PATH=data/market-history.jsonl.gz
HOST=0.0.0.0
PORT=8000
# Uzak erişim için güçlü token (Docker/VPS)
# NEXORA_API_TOKEN=

# --- Live ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
BINANCE_TESTNET=true
# LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY

# Market impact (square-root model scale)
IMPACT_COEFFICIENT=0.1
FEATURES_DB_PATH=data/features.sqlite3
# CORS origins comma-separated (e.g. https://dashboard.example.com)
# CORS_ORIGINS=
# JWT secret for signed dashboard tokens (optional alongside NEXORA_API_TOKEN)
# NEXORA_JWT_SECRET=
# NEXORA_JWT_TTL_SECONDS=86400
