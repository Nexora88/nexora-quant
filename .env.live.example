# Dedicated live-account process profile.
# Starts against Spot Testnet by default. Never put mainnet keys in this file.
TRADING_MODE=live
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
LIVE_CONFIRM=

SYMBOL=btcusdt
STARTING_CASH_USDT=20
ORDER_SIZE_USDT=5
MAX_ORDER_SIZE_USDT=5
MIN_ORDER_USDT=5
MAX_DAILY_LOSS_USDT=2
MAX_DAILY_FEE_USDT=0.75
RISK_PER_TRADE_PCT=0.35
MAX_CONCURRENT_POSITIONS=1
MAX_DATA_AGE_SECONDS=8
MIN_EDGE_OVER_FEES=2

# Never share the execution ledger with paper. Share only the strategy registry.
LIVE_DB_PATH=data/live.sqlite3
DUAL_ACCOUNT_DB_PATH=data/dual-account.sqlite3
ACCOUNT_ID=live-testnet
LEARNER_FROZEN=true
LEARNER_MIN_TRADES=25

# Run alongside paper on a different local port.
HOST=127.0.0.1
PORT=8001

RECONCILIATION_INTERVAL_SECONDS=30
