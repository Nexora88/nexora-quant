# Nexora Quant - 100 USDT PAPER evidence profile
# Copy to .env for a 1-2 week paper observation. Never put API secrets here.
TRADING_MODE=paper
BINANCE_TESTNET=true
STARTING_CASH_USDT=100
ORDER_SIZE_USDT=15
MAX_ORDER_SIZE_USDT=20
MIN_ORDER_USDT=6
MAX_CONCURRENT_POSITIONS=1
PAPER_DB_PATH=data/paper-100usdt.sqlite3

# One active strategy symbol; other symbols are depth/scan only.
SYMBOL=btcusdt
SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt,adausdt,dogeusdt,avaxusdt,linkusdt
UNIVERSE_AUTO=false
DEPTH_TOP_N=5
AUTONOMOUS_MODE=true
AUTONOMOUS_SYMBOL=false

# Conservative risk and entry controls.
RISK_PER_TRADE_PCT=0.35
MAX_DAILY_LOSS_USDT=2.00
MAX_CONSECUTIVE_LOSSES=3
MAX_SPREAD_BPS=12
MAX_DATA_AGE_SECONDS=3
ENTRY_MIN_SCORE=0.45
SIGNAL_CONFIRMATIONS=2
IMBALANCE_THRESHOLD=0.60
MIN_EDGE_OVER_FEES=2.5
MIN_REWARD_RISK_RATIO=2.0

# VIP0 Spot fee assumption; BNB discount deliberately disabled.
FEE_RATE=0.001
FEE_VIP_LEVEL=0
FEE_USE_BNB_DISCOUNT=false
TAKE_PROFIT_PCT=0.65
STOP_LOSS_PCT=0.30
TRAILING_STOP_PCT=0.15
USE_ATR_TARGETS=true
VOL_TARGET_ENABLED=true
WICK_STOP_CONFIRMATIONS=2

# Paper execution friction; conservative and explicit.
SIMULATED_SLIPPAGE_BPS=3
SIMULATED_LATENCY_MS=150
SIMULATED_PARTIAL_FILL_PROBABILITY=0.15
IMPACT_COEFFICIENT=0.15
STOP_STRESS_MULTIPLIER=2.5
STOP_TAIL_BPS=8
SIMULATION_SEED=42
PREFER_MAKER=false
MAKER_WAIT_SECONDS=8

# Anti-churn and session fee budget.
MIN_HOLD_SECONDS=20
MAX_HOLD_SECONDS=900
MAX_TRADES_PER_HOUR=4
MAX_DAILY_FEE_USDT=0.75
ENTRY_COOLDOWN_SECONDS=90
COMPOUND_FRACTION=0.25
PAPER_SOFT_GATES=false
LEARNER_FROZEN=true

# Lossless research history; separate from the paper account ledger.
MARKET_HISTORY_ENABLED=true
MARKET_HISTORY_PATH=data/market-history-100usdt.jsonl.gz
HISTORY_MAX_PENDING=1000

# Local dashboard only.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
